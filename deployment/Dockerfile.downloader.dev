FROM rust:1.91-trixie AS songrec-build
RUN apt update && apt install -y --no-install-recommends \
        pkg-config clang libclang-dev libglib2.0-dev libsoup-3.0-dev gettext libasound2-dev libpipewire-0.3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install songrec --no-default-features --root /songrec --locked

FROM debian:trixie-slim AS base
RUN apt update && apt install -y --no-install-recommends \
        ffmpeg \
        python3 \
        python3-pip \
        python3-venv \
        bash \
        curl \
        ca-certificates \
        libglib2.0-0t64 \
        libsoup-3.0-0 \
        libasound2t64 \
        libpipewire-0.3-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=songrec-build /songrec/bin/songrec /usr/local/bin/songrec
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir -U pip \
 && pip install --no-cache-dir --pre "yt-dlp[default,curl-cffi,deno]" \
 && pip install --no-cache-dir --pre "gallery-dl" \
 && pip install --no-cache-dir "bgutil-ytdlp-pot-provider==2.0.0" \
 && pip install --no-cache-dir --pre "spotdl"

RUN pip uninstall -y spotapi tls-client \
 && pip install --no-cache-dir "spotapi @ https://github.com/Desiders/SpotAPI/archive/b299d1d1f13e06273b686fa579edc2968ebdc7fd.tar.gz"

FROM rust:1.94-bookworm AS build
RUN apt update && apt install -y --no-install-recommends \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY Cargo.toml Cargo.lock ./
COPY bot/Cargo.toml bot/Cargo.toml
COPY cookie_assignment/Cargo.toml cookie_assignment/Cargo.toml
COPY downloader/Cargo.toml downloader/Cargo.toml
COPY downloader_client/Cargo.toml downloader_client/Cargo.toml
COPY migration/Cargo.toml migration/Cargo.toml
COPY proto/Cargo.toml proto/Cargo.toml

RUN mkdir -p bot/src cookie_assignment/src downloader/src downloader_client/src migration/src proto/src \
    && echo "fn main(){}" > bot/src/main.rs \
    && echo "fn main(){}" > cookie_assignment/src/main.rs \
    && echo "fn main(){}" > downloader/src/main.rs \
    && echo "fn main(){}" > migration/src/main.rs \
    && echo "" > downloader_client/src/lib.rs \
    && echo "" > migration/src/lib.rs \
    && echo "" > proto/src/lib.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo fetch --locked

COPY proto proto
COPY downloader downloader

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/usr/src/app/target,sharing=locked \
    touch proto/src/lib.rs proto/build.rs proto/proto/downloader.proto downloader/src/main.rs \
    && cargo build --locked --profile k8s-dev -p downloader \
    && mkdir -p /usr/src/app/bin \
    && cp /usr/src/app/target/k8s-dev/downloader /usr/src/app/bin/downloader

FROM base AS final
WORKDIR /app
COPY --from=build /usr/src/app/bin/downloader /app/downloader
ENV RUST_BACKTRACE=full
ENV PATH="/opt/venv/bin:$PATH"
ENTRYPOINT ["/app/downloader"]
